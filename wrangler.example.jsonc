{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "benx-ui",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "alias": {
    "ssh2": "./worker/ssh-relay-only.ts",
    "cpu-features": "./worker/ssh-cpu.cjs"
  },
  "define": {
    "__dirname": "\"/ssh2\""
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/sub/*",
      "/lab/*",
      "/telegram/*",
      "/owner/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "ADMIN_USERNAME": "admin",
    "AUTO_MIGRATE": "1"
  },
  "workers_dev": true
}

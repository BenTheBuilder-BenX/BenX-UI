[Unit]
Description=BenX server management agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/benx-agent.env
ExecStart=/usr/bin/python3 /opt/benx-agent/benx_agent.py
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target

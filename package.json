{
  "name": "benx-ui",
  "version": "0.9.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/verify-published-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "worker:dev": "wrangler dev --port 8787",
    "types": "wrangler types",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "node scripts/deploy.mjs",
    "check": "tsc -b && eslint .",
    "test": "vitest run",
    "prebuild": "node scripts/sync-agent.mjs && node scripts/sync-migrations.mjs",
    "precheck": "node scripts/sync-agent.mjs && node scripts/sync-migrations.mjs",
    "pretest": "node scripts/sync-agent.mjs && node scripts/sync-migrations.mjs",
    "predev": "node scripts/sync-agent.mjs && node scripts/sync-migrations.mjs",
    "preworker:dev": "node scripts/sync-agent.mjs && node scripts/sync-migrations.mjs",
    "test:ssh": "node scripts/test-ssh-runtime.mjs",
    "relay:build": "node scripts/build-relay.mjs",
    "agent:test": "python -m unittest discover -s agent/tests -v",
    "release:check": "npm run check && npm test && npm run agent:test && npm run build && npm run test:install && npm run test:ssh && npm run relay:build",
    "release:package": "node scripts/prepare-release.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "setup:resume": "node scripts/deploy.mjs --resume-install",
    "setup:link": "node scripts/deploy.mjs --renew-activation",
    "account:recover": "node scripts/deploy.mjs --recover-owner",
    "release:repository": "node scripts/set-repository.mjs",
    "test:install": "node scripts/test-install-runtime.mjs"
  },
  "dependencies": {
    "jose": "^6.1.3",
    "lucide-react": "^0.577.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261115.1",
    "@eslint/js": "^9.39.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.162.0",
    "miniflare": "5.20261113.0-beta",
    "esbuild": "0.28.2"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "Private panel database. Created and initialized automatically; no database ID or SQL commands needed."
      }
    }
  },
  "author": "Ben the Builder",
  "repository": {
    "type": "git",
    "url": "https://github.com/BenTheBuilder-BenX/BenX-UI.git"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
